{
  "name": "animoria-vscode",
  "displayName": "Animoria",
  "description": "Visual Asset Governance for developers — discover, preview, trace, and clean up animated (Lottie, dotLottie, Rive, GIF, APNG, SVG) and static (SVG, PNG, JPEG, WebP, AVIF) assets directly inside VS Code.",
  "version": "1.0.0",
  "publisher": "SxnnysideProject",
  "author": {
    "name": "Sxnnyside Project",
    "url": "https://github.com/sxnnyside-project"
  },
  "license": "MIT",
  "homepage": "https://github.com/sxnnyside-project/animoria#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sxnnyside-project/animoria.git",
    "directory": "packages/animoria-vscode"
  },
  "bugs": {
    "url": "https://github.com/sxnnyside-project/animoria/issues"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0D0D0F",
    "theme": "dark"
  },
  "keywords": [
    "asset governance",
    "duplicate detection",
    "static assets",
    "lottie",
    "dotlottie",
    "rive",
    "animation",
    "bodymovin",
    "preview",
    "after effects",
    "motion",
    "design",
    "gallery",
    "cleanup"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Visualization", "Other"],
  "qna": "marketplace",
  "activationEvents": ["workspaceContains:**/*.json", "onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "animoria",
          "title": "Animoria",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "animoria": [
        {
          "id": "animoria.gallery",
          "name": "Gallery",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "animoria.gallery",
        "contents": "No visual assets found in this workspace yet.\n\nAnimoria automatically discovers animated (Lottie, dotLottie, Rive, GIF, APNG, animated SVG) and static (SVG, PNG, JPEG, WebP, AVIF) files as you add them — no configuration needed.\n\nJust added some? Indexing runs in the background and the Gallery updates on its own.\n\n[Refresh Gallery](command:animoria.refresh)"
      }
    ],
    "commands": [
      {
        "command": "animoria.refresh",
        "title": "Animoria: Refresh Gallery",
        "icon": "$(refresh)"
      },
      {
        "command": "animoria.openPreview",
        "title": "Animoria: Open Preview"
      },
      {
        "command": "animoria.revealInExplorer",
        "title": "Animoria: Reveal in Explorer"
      },
      {
        "command": "animoria.search",
        "title": "Animoria: Search Animations",
        "icon": "$(search)"
      },
      {
        "command": "animoria.runGovernance",
        "title": "Animoria: Run Governance Analysis",
        "icon": "$(shield)"
      },
      {
        "command": "animoria.viewGovernanceReport",
        "title": "Animoria: View Governance Report"
      },
      {
        "command": "animoria.exportGovernanceReport",
        "title": "Animoria: Export Governance Report to File"
      },
      {
        "command": "animoria.deleteAsset",
        "title": "Animoria: Delete Asset",
        "icon": "$(trash)"
      },
      {
        "command": "animoria.startCleanupReview",
        "title": "Animoria: Review Cleanup Opportunities",
        "icon": "$(clear-all)"
      },
      {
        "command": "animoria.resolveDuplicates",
        "title": "Animoria: Resolve Duplicates",
        "icon": "$(diff)"
      },
      {
        "command": "animoria.generateSnippet",
        "title": "Animoria: Generate Code Snippet",
        "icon": "$(code)"
      },
      {
        "command": "animoria.toggleViewMode",
        "title": "Animoria: Toggle Directory Tree / Flat View",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "animoria.refresh",
          "when": "view == animoria.gallery",
          "group": "navigation"
        },
        {
          "command": "animoria.search",
          "when": "view == animoria.gallery",
          "group": "navigation"
        },
        {
          "command": "animoria.runGovernance",
          "when": "view == animoria.gallery",
          "group": "navigation"
        },
        {
          "command": "animoria.startCleanupReview",
          "when": "view == animoria.gallery",
          "group": "navigation"
        },
        {
          "command": "animoria.toggleViewMode",
          "when": "view == animoria.gallery",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "animoria.openPreview",
          "when": "view == animoria.gallery && viewItem != animoriaFolder && viewItem != animoriaHealthScore && viewItem != animoriaAnimatedAssetsSection && viewItem != animoriaStaticAssetsSection && viewItem != animoriaGovernanceSection",
          "group": "inline"
        },
        {
          "command": "animoria.revealInExplorer",
          "when": "view == animoria.gallery && viewItem != animoriaFolder && viewItem != animoriaHealthScore && viewItem != animoriaAnimatedAssetsSection && viewItem != animoriaStaticAssetsSection && viewItem != animoriaGovernanceSection"
        },
        {
          "command": "animoria.deleteAsset",
          "when": "view == animoria.gallery && viewItem == animoriaGovernanceIssue",
          "group": "inline"
        },
        {
          "command": "animoria.resolveDuplicates",
          "when": "view == animoria.gallery && viewItem == animoriaGovernanceIssueDuplicate",
          "group": "inline"
        },
        {
          "command": "animoria.generateSnippet",
          "when": "view == animoria.gallery && (viewItem == animoriaAsset || viewItem == animoriaGovernanceIssue || viewItem == animoriaGovernanceIssueDuplicate)"
        },
        {
          "command": "animoria.viewGovernanceReport",
          "when": "view == animoria.gallery && viewItem == animoriaGovernanceSection"
        },
        {
          "command": "animoria.exportGovernanceReport",
          "when": "view == animoria.gallery && viewItem == animoriaGovernanceSection"
        }
      ]
    },
    "configuration": {
      "title": "Animoria",
      "properties": {
        "animoria.enableThumbnails": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Generate static thumbnail previews for animated assets in the gallery sidebar. Rendered natively — no Chrome/Chromium installation required."
        },
        "animoria.governance.overusedThreshold": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "markdownDescription": "Number of source file references at or above which an asset is flagged as **overused** in the Governance report."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite build --watch",
    "lint": "biome lint src",
    "clean": "rm -rf dist",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@animoria/core": "workspace:*"
  },
  "devDependencies": {
    "lottie-web": "5.12.2",
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.6"
  }
}
