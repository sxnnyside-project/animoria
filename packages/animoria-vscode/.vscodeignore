# Source files — never bundle
src/
tsconfig.json
vite.config.ts
.turbo/

# Dev dependencies and workspace tooling
node_modules/
.pnpm-store/
*.tgz

# Test and lint artefacts
tests/
*.test.ts
*.spec.ts
**/__tests__/
vitest.config.ts

# Build intermediates and maps
dist/**/*.map
# The shared UI's sourcemap is 1.1 MB and only useful to us. The bundle itself
# must ship — it *is* the extension's UI.
media/*.map
# Scripts that produce media/, not consumed at runtime.
scripts/

# Monorepo root files that leak in
../../.gitignore
../../pnpm-lock.yaml
../../pnpm-workspace.yaml
../../turbo.json
../../package.json
../../README.md

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Keep in the .vsix:
# ✔  dist/extension.js
# ✔  media/animoria-ui.js   (the shared UI bundle — the panel is blank without it)
# ✔  media/tokens.css
# ✔  assets/icon.svg
# ✔  assets/icon.png   (if present)
# ✔  package.json
# ✔  README.md
# ✔  CHANGELOG.md
# ✔  LICENSE           (if present)

# Animoria generated artifacts
.animoria/
