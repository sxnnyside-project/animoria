{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@animoria/ui/bridge": [
        "../animoria-ui/src/bridge/index.ts"
      ],
      "@animoria/core/contracts": [
        "../animoria-core/src/contracts.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}