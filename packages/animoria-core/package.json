{
  "name": "@animoria/core",
  "version": "1.0.1",
  "description": "IDE-agnostic scanning, parsing, usage tracing, and governance engine for animated assets (Lottie, dotLottie, Rive, GIF, APNG, animated SVG).",
  "keywords": [
    "lottie",
    "dotlottie",
    "rive",
    "animation",
    "asset-governance",
    "static-analysis"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "animoria": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./i18n": {
      "types": "./dist/i18n/locales.d.ts",
      "import": "./dist/i18n/locales.js",
      "default": "./dist/i18n/locales.js"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "import": "./dist/parsers/index.js",
      "default": "./dist/parsers/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src",
    "clean": "rm -rf dist",
    "build:sea": "pnpm build && node scripts/build-sea.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "vitest": {
    "include": [
      "tests/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@dotlottie/dotlottie-js": "^1.8.0",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "js-yaml": "^5.2.3"
  }
}
