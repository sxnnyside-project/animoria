{
  "name": "@animoria/contracts",
  "version": "2.3.0",
  "description": "Shared canonical data types, protocol definitions, and UI contracts for Animoria.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify:bindings": "git diff --exit-code src/generated",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
