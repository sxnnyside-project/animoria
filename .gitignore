# The stray sandbox harness `package:jetbrains` used to copy into the plugin jar,
# where no Kotlin code read it. The shared UI itself is packaged by Gradle's
# `copySharedUi` task into `build/generated-resources/web/`, not from the source tree.
packages/animoria-jetbrains/src/main/resources/assets/

# Self-contained native CLI binaries — regenerated per-platform by `scripts/build-sea.mjs`
packages/animoria-core/sea/
packages/animoria-jetbrains/src/main/resources/native/

