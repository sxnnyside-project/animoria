{
  "name": "animoria",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo clean",
    "audit": "pnpm audit",
    "sandbox": "turbo run dev --filter=animoria-sandbox",
    "package:vscode": "pnpm --filter animoria-vscode package",
    "package:jetbrains-daemon": "pnpm --filter @animoria/core build:sea && node scripts/copy-sea-into-jetbrains.mjs",
    "package:jetbrains": "pnpm --filter animoria-sandbox build && mkdir -p packages/animoria-jetbrains/src/main/resources/assets && cp -r apps/animoria-sandbox/dist/* packages/animoria-jetbrains/src/main/resources/assets/ && pnpm package:jetbrains-daemon && cd packages/animoria-jetbrains && ./gradlew buildPlugin",
    "package:all": "pnpm package:vscode && pnpm package:jetbrains",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "turbo": "latest",
    "typescript": "^5.0.0"
  }
}
